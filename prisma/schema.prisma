generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model File {
  id        Int      @id @default(autoincrement())
  filePath  String   @unique @map("file_path")
  fileName  String   @map("file_name")
  mediaType String   @map("media_type")
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  tags FileTag[]

  @@map("files")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String

  files    FileTag[]
  parents  TagRelation[] @relation("ChildRelation")
  children TagRelation[] @relation("ParentRelation")

  @@map("tags")
}

model TagRelation {
  parentId   Int      @map("parent_id")
  childId    Int      @map("child_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  parent     Tag      @relation("ParentRelation", fields: [parentId], references: [id])
  child      Tag      @relation("ChildRelation", fields: [childId], references: [id])

  @@id([parentId, childId])
  @@map("tag_relations")
}

model FileTag {
  fileId Int @map("file_id")
  tagId  Int @map("tag_id")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([fileId])
  @@index([tagId])
  @@map("file_tags")
}

model Canvas {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  dataPath  String   @map("data_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("canvases")
}

model Blacklist {
  id        Int            @id @default(autoincrement())
  listName  String         @unique @map("list_name")
  createdAt DateTime       @default(now()) @map("created_at")
  tags      BlacklistTag[]

  @@map("blacklists")
}

model BlacklistTag {
  id     Int       @id @default(autoincrement())
  listId Int       @map("list_id")
  tag    String
  list   Blacklist @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tag])
  @@map("blacklist_tags")
}

model Alias {
  id        Int        @id @default(autoincrement())
  realTag   String     @unique @map("real_tag")
  createdAt DateTime   @default(now()) @map("created_at")
  aliases   AliasTag[]

  @@map("aliases")
}

model AliasTag {
  id      Int   @id @default(autoincrement())
  aliasId Int   @map("alias_id")
  tag     String
  alias   Alias @relation(fields: [aliasId], references: [id], onDelete: Cascade)

  @@unique([aliasId, tag])
  @@map("alias_tags")
}
